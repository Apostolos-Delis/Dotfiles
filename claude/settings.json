{
  "env": {
    "ANTHROPIC_BASE_URL": "https://inference.baseten.co",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "CLAUDE_CODE_USE_VERTEX": "0",
    "CLAUDE_CODE_USE_FOUNDRY": "0",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "opendoor/opus-5",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "opendoor/opus-5",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Gateway model"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "TodoWrite",
      "Skill"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(sudo rm:*)",
      "Bash(chmod 777:*)",
      "Bash(> /dev/sda:*)",
      "Bash(mkfs:*)",
      "Bash(dd if:*)"
    ]
  },
  "model": "opendoor/glm-5.2",
  "availableModels": [
    "opendoor/glm-5.2",
    "opendoor/opus-5"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/ccnotify/ccnotify.py UserPromptSubmit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/ccnotify/ccnotify.py Stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/ccnotify/ccnotify.py Notification"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-file.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-console-log.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-settings.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'hook=\"$HOME/.claude/skills/impeccable/scripts/hook.mjs\"; if [ -f \"$hook\" ]; then exec node \"$hook\"; fi'",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/show-analysis-summary.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"/opt/homebrew/bin/bun\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)src/index.ts\" 2>/dev/null || echo \"\"'"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-wiggum@claude-code-plugins": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-mem@thedotmack": false,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "trustedDirectories": [
    "~/Documents/repos"
  ],
  "skipWorkflowUsageWarning": true
}
